# ============================================================================
# 默认配置。本文件进版本控制，不要在服务器上直接改它。
# 服务器上复制 local.yaml.example 为 local.yaml 再改，local.yaml 会覆盖本文件。
# ============================================================================

paths:
  labels_dir: ""                      # YOLO 标注目录（*.txt）
  images_dir: ""                      # 图片目录
  classes_yaml: ""                    # 类别表 yaml（347 类那份）
  output_dir: "./output"

# ---------------------------------------------------------------------------
# 自建 Qwen 服务：用于生成第三轮的描述语句和同类目标的视觉指代
# ---------------------------------------------------------------------------
vlm:
  enabled: true                       # false = 全部回落到模板生成，不调服务
  api_url: "http://192.168.78.36:3012/v1/chat/completions"
  api_key: ""                         # 建议用环境变量 VLM_API_KEY 注入
  model: "Qwen3.6-27B"
  timeout: 300
  temperature: 0.35
  max_tokens: 1024
  concurrency: 4                      # 并发请求数，先小后大，看服务承载
  max_retries: 3
  cache_dir: "./output/vlm_cache"     # 按图落盘，支持断点续跑

# ---------------------------------------------------------------------------
# 坐标系。Qwen3-VL-8B-Instruct 吃 0~1000 归一化坐标。
# ---------------------------------------------------------------------------
coords:
  scale: 1000
  origin: 0                           # 0 = 0~1000；改 1 则输出 1~1000

# ---------------------------------------------------------------------------
# 质量过滤。阈值用【面积占比】而非绝对像素 —— 数据分辨率跨度大
# (128x128 ~ 2048x1440)，绝对像素阈值会对同一目标给出相反判定。
# ---------------------------------------------------------------------------
quality:
  min_area_ratio: 0.001               # 低于此判定太小，看不清
  max_area_ratio: 0.5                 # 高于此判定为全图框，做定位样本无意义
  min_short_side_px: 16               # 辅助条件：原图上本身就糊的目标
  # VLM 指代短语的字数上限。指代只需唯一锁定目标，堆特征会让问题读不下去
  # （实测模型会写出「画面中上部，停在白色轿车和黑色轿车之间，靠近一棵绿树的
  # 那个目标」这种 30 字三从句）。超限就丢弃，回落模板空间指代。
  max_referring_len: 20

  # 指代短语的收尾称呼。「目标」是标注术语，正常人不会说「那个目标是什么」。
  # 默认用光杆的「那个」——「画面右下角、银色的那个是什么？」，自然且中性。
  # 不用「物体」是因为类别里有人员，把人叫「那个物体」很别扭。
  neutral_noun: "那个"

  # 会暗示目标类别的词。指代里不能出现 —— 「车身银色的那个目标」字面上没说
  # 类别名，但「车身」已经把答案限定成车辆，砍掉了人员、船舶等一大片；
  # 「正骑行的那个目标」把答案限定成自行车/摩托车/三轮车。这是类别名泄漏的
  # 隐蔽形式，比字面泄漏更难发现。
  #
  # 按你的类别体系增删。指代只该用「位置 + 颜色 + 与其他物体的相对关系」，
  # 这三类都不暗示目标是什么。
  category_hint_words:
    # 部件名 —— 有这些部件的只可能是某一类东西
    - 车身
    - 车头
    - 车尾
    - 车顶
    - 车轮
    - 车门
    - 车窗
    - 船身
    - 船头
    - 船尾
    - 甲板
    - 桅杆
    - 机身
    - 机翼
    - 螺旋桨
    - 炮塔
    - 炮管
    - 履带
    # 动作 —— 只有某类东西会做这些动作
    - 骑行
    - 骑着
    - 驾驶
    - 乘坐
    - 载着
    - 行驶
    - 停放
    - 停靠
    - 停在
    - 停着
    - 航行
    - 飞行
    - 起飞
    - 降落
    - 拖着
  sanity_max_boxes: 1000              # 超过必然是标注文件损坏，不是真有这么多目标

# ---------------------------------------------------------------------------
# 难度分级与配额。总难度取三个维度里最难的一项。
# ---------------------------------------------------------------------------
difficulty:
  qwen_equiv_size: 1024               # 面积占比 -> 模型实际看到的等效像素的基准
  size_easy_px: 64                    # >=64px 等效 -> easy
  size_medium_px: 32                  # >=32px 等效 -> medium
  size_reject_px: 16                  # < 16px 等效 -> 剔除
  dense_medium: 3                     # 同图同类 2~3 个 -> medium
  dense_hard: 8                       # 同图同类 4~8 个 -> hard；超过则无法指代
  hard_quota: 0.10                    # 困难目标在最终数据集中的占比

# ---------------------------------------------------------------------------
# 采样
# ---------------------------------------------------------------------------
sampling:
  samples_per_image_cap: 8            # 同一张图最多产出多少条样本
  multi_target_ratio: 0.10            # 一次涉及 2~3 个目标的样本占比
  multi_target_max: 3
  negative_ratio: 0.05                # 拒答样本占比（问图中不存在的类别）
  seed: 20260826                      # 固定种子，保证可复现

# ---------------------------------------------------------------------------
# train/val 划分。必须按【原始来源】分组，不能按图片随机分 ——
# 数据含视频抽帧和 Roboflow 增强，同源图会泄漏到验证集。
# ---------------------------------------------------------------------------
split:
  val_ratio: 0.05
  group_by_source: true

output:
  format: sharegpt
  image_path_style: filename          # filename | absolute | relative
  include_metadata: true
