# ============================================================================
# 服务器本地配置模板。
#
#   cp config/local.yaml.example config/local.yaml
#   然后只改下面这些 —— local.yaml 已在 .gitignore 里，地址和密钥不会进版本库。
#
# 【本文件刻意只列「每台机器必须自己填」的项。】
# 其余全部参数（质量阈值、难度分级、任务配比、问法库、质检阈值、划分比例……）
# 都在 config/default.yaml 里，带完整注释，要调就去那儿看了再往这里加一条覆盖。
#
# 不要把 default.yaml 整个复制过来 —— 那样每次升级都会有一批过期的值
# 静默盖住新默认值，而且不报错。这份模板以前就是那么写的，积了四个死键。
# ============================================================================

paths:
  labels_dir: "/data/xxx/labels"      # YOLO 标注目录（*.txt）
  images_dir: "/data/xxx/images"      # 图片目录
  classes_yaml: "/data/xxx/classes.yaml"   # 类别表（那份 300 多类的）
  output_dir: "./output"

vlm:
  # 单个服务写这三项即可
  api_url: "http://192.168.78.36:3012/v1/chat/completions"
  model: "Qwen3.8-27B"
  api_key: ""                         # 建议留空，用环境变量 VLM_API_KEY 注入
  concurrency: 4                      # 先 4 跑通，再按服务承载往上加

  # 多个服务时改用池子。写了 endpoints 就以它为准，上面的 api_url/model 不再生效。
  # concurrency 同时是权重 —— 大的分到的请求多。
  #
  # endpoints:
  #   - {name: "主力", api_url: "http://192.168.78.36:3012/v1/chat/completions",
  #      model: "Qwen3.8-27B", concurrency: 8}
  #   - {name: "备用", api_url: "http://192.168.78.37:3012/v1/chat/completions",
  #      model: "Qwen2.5-VL-72B", concurrency: 4}

  # 有第二个模型时，让质检走它 —— 用生成描述的同一个模型来审自己写的东西，
  # 它会倾向于认同自己的输出。
  #
  # roles:
  #   review:
  #     temperature: 0.0
  #     endpoints:
  #       - {name: "质检", api_url: "http://192.168.78.40:3012/v1/chat/completions",
  #          model: "Qwen2.5-VL-72B", concurrency: 4}

# ---------------------------------------------------------------------------
# 下面几项是「偶尔需要临时改」的，默认注释掉，用完记得注释回去。
# ---------------------------------------------------------------------------

# 服务不支持 SSE 时关掉流式。关了以后一次调用几十秒和「卡死」长得一模一样。
# vlm:
#   stream: false

# 指定任务单独跑一次（补跑）时才打开。跑完必须注释回去，否则全量跑出来是单一任务。
# （这里曾经默认就写着单任务配置，复制过去的人不知情，跑出来 100% 一个任务。）
#
# 【必须把不要的任务逐个写 0】。配置是深合并的，只写想要的那几个，
# 其余会保留 default.yaml 里的权重，等于没关。
#
# 补跑要配一个不同的 output_dir，跑完用 scripts/merge_by_group.py 按来源分组
# 合并回主数据集 —— 它不会重新划分，新样本按同源组归到已有的 train/val/test。
#
# tasks_ratio_mode: fill      # 补跑要的是量，配比在合并之后算
# tasks_cap:                  # 绝对条数上限，防止某个任务把数据集淹掉
#   count_class: 8000
# tasks:
#   inventory_locate:   40
#   detect_describe:    40
#   count_class:        20
#   ground_unique:       0
#   detect_class:        0
#   region_identify:     0
#   exist_negative:      0
#   attribute_qa:        0
#   spatial_relation:    0
#   ground_appearance:   0
#   ground_state:        0
#   ground_part:         0
#   ground_position:     0
#   ground_relation:     0
#   ground_contrast:     0
#   ground_full:         0
